GEMINI_API_KEY=
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "DAYTOZN <cv@yourdomain.com>"
RESEND_FROM_EMAIL=

# Optional: WhatsApp number for the floating "Need help?" button (digits only, e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: override the Gemini model (default: gemini-3.5-flash)
GEMINI_MODEL=
